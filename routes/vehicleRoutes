const express = require('express');
const { protect, adminMiddleware } = require('../middleware/authmiddleware');
const {
  getVehicles,
  getVehicleById,
  addVehicle,
  updateVehicle,
  deleteVehicle
} = require('../controllers/vehicleController');

const router = express.Router();

// Public routes
router.get('/', getVehicles);
router.get('/:id', getVehicleById);

// Admin routes
router.post('/', protect, adminMiddleware, addVehicle);
router.put('/:id', protect, adminMiddleware, updateVehicle);
router.delete('/:id', protect, adminMiddleware, deleteVehicle);

module.exports = router;
